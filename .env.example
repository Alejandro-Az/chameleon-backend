APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Canal de log activo. "stack" delega a LOG_STACK. Alternativa directa en producción: "json"
LOG_CHANNEL=stack
# Canales internos del stack. Desarrollo: "single" | Producción: "json"
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Kaan Core: Metadata ─────────────────────────────────────
KAAN_NAME="Kaan Core Backend"
KAAN_VERSION="0.2.0-alpha"

# ── Kaan Core: Admin Bootstrap ──────────────────────────────
KAAN_ADMIN_EMAIL=admin@kaan.dev
KAAN_ADMIN_PASSWORD=Secret123456

# ── Kaan Core: Auth & Registration ──────────────────────────
KAAN_AUTH_LOGIN_FIELD=email_or_username
KAAN_AUTH_REQUIRE_VERIFIED_EMAIL=false
KAAN_AUTH_VERIFY_EMAIL_EXPIRE_MINUTES=60
KAAN_AUTH_ALLOW_PUBLIC_REGISTRATION=false
KAAN_AUTH_REGISTER_ISSUE_TOKEN=true
KAAN_AUTH_REGISTRATION_DEFAULT_STATUS=active
KAAN_AUTH_DEFAULT_ROLE=user
KAAN_AUTH_REGISTER_REQUIRE_NAME=true

# ── Kaan Core: Feature Flags ────────────────────────────────
# NOTE: auth_sessions and rbac are core capabilities (always active).
KAAN_FEATURE_ADMIN=true
KAAN_FEATURE_AUDIT=true
KAAN_FEATURE_ADMIN_SECURITY=true
KAAN_FEATURE_LOGIN_ATTEMPTS=true
KAAN_FEATURE_API_KEYS=false
KAAN_FEATURE_POLICY_CENTER=false
KAAN_FEATURE_APPOINTMENTS=false

# ── Kaan Core: Pagination ───────────────────────────────────
KAAN_PAGINATION_DEFAULT=15
KAAN_PAGINATION_MAX=100

# ── Kaan Core: API Keys / Service Accounts ──────────────────
KAAN_API_KEYS_PREFIX=kk_live_
KAAN_API_KEYS_PREFIX_LENGTH=12
KAAN_API_KEYS_EXCHANGE_ATTEMPTS=10
KAAN_API_KEYS_EXCHANGE_DECAY_SECONDS=60
KAAN_API_KEYS_RETENTION_DAYS=90

# ── Kaan Core: Security Center ──────────────────────────────
KAAN_SECURITY_SESSIONS_EXPIRED_DAYS=7
KAAN_SECURITY_SESSIONS_REVOKED_DAYS=30
KAAN_SECURITY_LOGIN_ATTEMPTS_RETENTION_DAYS=30
KAAN_SECURITY_EXPOSE_RAW_LOGIN=false

# ── Kaan Core: Retention ────────────────────────────────────
KAAN_AUDIT_RETENTION_DAYS=

# ── Kaan Core: Frontend Links (Headless) ────────────────────
KAAN_FRONTEND_VERIFY_EMAIL_URL=
KAAN_FRONTEND_RESET_PASSWORD_URL=

# ── Kaan Core: Ops ──────────────────────────────────────────
KAAN_SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=5
